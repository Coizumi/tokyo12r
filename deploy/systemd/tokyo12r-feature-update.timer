[Unit]
Description=Schedule TOKYO12R JRA feature updates

[Timer]
OnCalendar=Fri *-*-* 22:10:00
OnCalendar=Sat *-*-* 08:45:00
OnCalendar=Sat *-*-* 09..20:15,45:00
OnCalendar=Sat *-*-* 22:10:00
OnCalendar=Sun *-*-* 08:45:00
OnCalendar=Sun *-*-* 09..20:15,45:00
OnCalendar=Mon *-*-* 08:45:00
OnCalendar=Mon *-*-* 09..20:15,45:00
OnCalendar=Tue *-*-* 08:45:00
OnCalendar=Tue *-*-* 09..20:15,45:00
Persistent=true
RandomizedDelaySec=0
Unit=tokyo12r-feature-update.service

[Install]
WantedBy=timers.target
